<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.logic_monitor.v3.show_options.groups.configuration") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/logic_monitor/v3.option_logic_monitor_account_name") } do %>
    <span class="truncate"><%= integration.option_logic_monitor_account_name.presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/logic_monitor/v3.option_access_id") } do %>
    <span class="truncate"><%= mask(integration.option_access_id).presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/logic_monitor/v3.option_access_key") } do %>
    <span class="truncate"><%= mask(integration.option_access_key).presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/logic_monitor/v3.option_bearer_token") } do %>
    <span class="truncate"><%= mask(integration.option_bearer_token).presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/logic_monitor/v3.option_alert_acknowledged") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_alert_acknowledged } %>
  <% end %>
<% end %>
