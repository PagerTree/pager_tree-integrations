<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.live_call_routing.twilio.v3.show_options.groups.voicemail") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/live_call_routing/twilio/v3.option_record") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_record } %>
  <% end %>

  <% if integration.option_record %>
    <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/live_call_routing/twilio/v3.option_send_straight_to_voicemail") } do %>
      <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_send_straight_to_voicemail } %>
    <% end %>

    <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/live_call_routing/twilio/v3.option_record_emails_list") } do %>
      <% if integration.option_record_emails.any? %>
        <% integration.option_record_emails.each do |email| %>
          <%= link_to email, "mailto:#{email}", class: "truncate" %>
        <% end %>
      <% else %>
        (<%= t("pager_tree.integrations.common.none") %>)
      <% end %>
    <% end %>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/live_call_routing/twilio/v3.option_banned_phones_list") } do %>
    <%= integration.option_banned_phones.length %>
  <% end %>
<% end %>

<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.live_call_routing.twilio.v3.show_options.groups.call_behavior") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/live_call_routing/twilio/v3.option_max_wait_time") } do %>
    <%= integration.option_max_wait_time.presence || "-" %>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/live_call_routing/twilio/v3.option_force_input") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_force_input } %>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/live_call_routing/twilio/v3.option_skip_resolve_on_hangup") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_skip_resolve_on_hangup } %>
  <% end %>
<% end %>
