<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.live_call_routing.twilio.v3.show_options.groups.twilio_credentials") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/live_call_routing/twilio/v3.option_account_sid") } do %>
    <span class="truncate"><%= integration.option_account_sid %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/live_call_routing/twilio/v3.option_api_region") } do %>
    <%=
      case integration.option_api_region
      when "dublin.ie1" then "IE1 (Dublin)"
      when "sydney.au1" then "AU1 (Sydney)"
      else
        "US1 (Ashburn)"
      end
    %>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/live_call_routing/twilio/v3.option_api_key") } do %>
    <span class="truncate"><%= mask integration.option_api_key %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/live_call_routing/twilio/v3.option_api_secret") } do %>
    <span class="truncate"><%= mask integration.option_api_secret %></span>
  <% end %>
<% end %>

