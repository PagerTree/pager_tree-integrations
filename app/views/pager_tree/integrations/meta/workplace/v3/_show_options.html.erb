<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.meta.workplace.v3.show_options.groups.configuration") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/meta/workplace/v3.option_group_id") } do %>
    <span class="truncate"><%= integration.option_group_id.presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/meta/workplace/v3.option_access_token") } do %>
    <span class="truncate"><%= mask(integration.option_access_token).presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/meta/workplace/v3.option_app_secret") } do %>
    <span class="truncate"><%= mask(integration.option_app_secret).presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/meta/workplace/v3.option_outgoing_enabled") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_outgoing_enabled } %>
  <% end %>
<% end %>

<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.meta.workplace.v3.show_options.groups.advanced") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("pager_tree.integrations.common.option_outgoing_rules") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_outgoing_rules.present? } %>
  <% end %>
<% end %>
