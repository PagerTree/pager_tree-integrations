<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.meta.workplace.v3.show_options.groups.configuration") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/meta/workplace/v3.option_group_id") } do %>
    <span class="truncate"><%= integration.option_group_id.presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/meta/workplace/v3.option_access_token") } do %>
    <span class="truncate"><%= mask(integration.option_access_token).presence || "-" %></span>
  <% end %>
<% end %>

<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.meta.workplace.v3.show_options.groups.advanced") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("pager_tree.integrations.common.option_outgoing_rules"), fixed_height: false } do %>
    <% if integration.option_outgoing_rules.present? %>
      <pre class="max-h-40 w-full overflow-y-auto rounded bg-gray-50 p-2 text-xs text-gray-800"><%= integration.option_outgoing_rules %></pre>
    <% else %>
      <span class="text-gray-400">-</span>
    <% end %>
  <% end %>
<% end %>
