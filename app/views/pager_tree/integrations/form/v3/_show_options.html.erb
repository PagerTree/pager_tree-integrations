<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.form.v3.show_options.groups.content") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/form/v3.option_form_title") } do %>
    <span class="truncate"><%= integration.option_form_title.presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/form/v3.option_form_header") } do %>
    <span class="truncate"><%= integration.option_form_header.presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/form/v3.option_form_instructions") } do %>
    <span class="truncate"><%= integration.option_form_instructions.presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/form/v3.option_form_footer_text") } do %>
    <span class="truncate"><%= integration.option_form_footer_text.presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/form/v3.option_form_footer_link") } do %>
    <span class="truncate"><%= integration.option_form_footer_link.presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/form/v3.option_form_logo") } do %>
    <span class="truncate">
      <% if integration.option_form_logo.present? %>
        <%= link_to integration.option_form_logo.blob.filename, integration.option_form_logo, target: "_blank" %>
      <% else %>
        -
      <% end %>
    </span>
    <%= link_to t("delete"), main_app.integration_attachment_path(integration, integration.option_form_logo.id), method: :delete, class: "btn btn-small btn-danger outline", data: { confirm: t("are_you_sure") } if integration.option_form_logo.present? %>
  <% end %>
<% end %>

<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.form.v3.show_options.groups.required_fields") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/form/v3.option_form_email_required") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_form_email_required } %>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/form/v3.option_form_phone_required") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_form_phone_required } %>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/form/v3.option_form_description_required") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_form_description_required } %>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/form/v3.option_form_urgency_required") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_form_urgency_required } %>
  <% end %>
<% end %>
