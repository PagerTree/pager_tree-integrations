<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.channel.microsoft_teams.v3.show_options.groups.configuration") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/integration.option_incoming_webhook_url") } do %>
    <span class="truncate"><%= mask(integration.option_incoming_webhook_url).presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/channel/microsoft_teams/v3.option_time_zone") } do %>
    <span class="truncate"><%= integration.option_time_zone.presence || "-" %></span>
  <% end %>
<% end %>

<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.channel.microsoft_teams.v3.show_options.groups.event_triggers") } do %>
  <% [:alert_open, :alert_acknowledged, :alert_resolved, :alert_dropped, :compact_message].each do |opt| %>
    <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/integration.option_#{opt}") } do %>
      <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.send("option_#{opt}") } %>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.channel.microsoft_teams.v3.show_options.groups.advanced") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("pager_tree.integrations.common.option_outgoing_rules"), fixed_height: false } do %>
    <% if integration.option_outgoing_rules.present? %>
      <pre class="max-h-40 w-full overflow-y-auto rounded bg-gray-50 p-2 text-xs text-gray-800"><%= integration.option_outgoing_rules %></pre>
    <% else %>
      <span class="text-gray-400">-</span>
    <% end %>
  <% end %>
<% end %>
