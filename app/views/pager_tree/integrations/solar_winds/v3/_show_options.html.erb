<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.solar_winds.v3.show_options.groups.configuration") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/solar_winds/v3.option_alert_acknowledged") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_alert_acknowledged } %>
  <% end %>

  <% if integration.option_alert_acknowledged %>
    <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/solar_winds/v3.option_server_url") } do %>
      <span class="truncate"><%= integration.option_server_url.presence || "-" %></span>
    <% end %>

    <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/solar_winds/v3.option_server_username") } do %>
      <span class="truncate"><%= mask(integration.option_server_username).presence || "-" %></span>
    <% end %>

    <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/solar_winds/v3.option_server_password") } do %>
      <span class="truncate"><%= mask(integration.option_server_password).presence || "-" %></span>
    <% end %>

    <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/solar_winds/v3.option_proxy_url") } do %>
      <span class="truncate"><%= mask(integration.option_proxy_url).presence || "-" %></span>
    <% end %>
  <% end %>
<% end %>
