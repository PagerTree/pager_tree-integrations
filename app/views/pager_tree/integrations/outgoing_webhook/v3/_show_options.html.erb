<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.outgoing_webhook.v3.show_options.groups.configuration") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/outgoing_webhook/v3.option_webhook_url") } do %>
    <span class="truncate"><%= integration.option_webhook_url.presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/outgoing_webhook/v3.option_username") } do %>
    <span class="truncate"><%= mask(integration.option_username).presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/outgoing_webhook/v3.option_password") } do %>
    <span class="truncate"><%= mask(integration.option_password).presence || "-" %></span>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/outgoing_webhook/v3.option_proxy_url") } do %>
    <span class="truncate"><%= integration.option_proxy_url.presence || "-" %></span>
  <% end %>
<% end %>

<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.outgoing_webhook.v3.show_options.groups.event_triggers") } do %>
  <%
    event_opts = [
      :alert_created,
      :alert_open,
      :alert_acknowledged,
      :alert_rejected,
      :alert_timeout,
      :alert_resolved,
      :alert_dropped,
      :alert_handoff,
      :comment_created,
      :comment_updated,
      :comment_destroyed,
      :event_reminder_going_on_call,
      :event_reminder_going_off_call
    ]
  %>
  <% event_opts.each do |opt| %>
    <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/integration.option_#{opt}"), label_width: "w-64" } do %>
      <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.send("option_#{opt}") } %>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "shared/components/detail_group", locals: { title: t("pager_tree.integrations.outgoing_webhook.v3.show_options.groups.advanced") } do %>
  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/outgoing_webhook/v3.option_template"), fixed_height: false } do %>
    <% if integration.option_template.present? %>
      <pre class="max-h-40 w-full overflow-y-auto rounded bg-gray-50 p-2 text-xs text-gray-800"><%= integration.option_template %></pre>
    <% else %>
      <span class="text-gray-400">-</span>
    <% end %>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("activerecord.attributes.pager_tree/integrations/outgoing_webhook/v3.option_send_linked") } do %>
    <%= render partial: "shared/components/badge_enabled", locals: { enabled: integration.option_send_linked } %>
  <% end %>

  <%= render layout: "shared/components/detail_row", locals: { label: t("pager_tree.integrations.common.option_outgoing_rules"), fixed_height: false } do %>
    <% if integration.option_outgoing_rules.present? %>
      <pre class="max-h-40 w-full overflow-y-auto rounded bg-gray-50 p-2 text-xs text-gray-800"><%= integration.option_outgoing_rules %></pre>
    <% else %>
      <span class="text-gray-400">-</span>
    <% end %>
  <% end %>
<% end %>
